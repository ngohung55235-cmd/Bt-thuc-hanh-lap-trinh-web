@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <!-- Success Icon with Ripple effect -->
                <div class="mb-4 d-inline-block position-relative">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" 
                         style="width: 100px; height: 100px;">
                        <i class="bi bi-check2-all display-4 fw-bold"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-3">Đặt Hàng Thành Công!</h2>
                <p class="text-secondary mb-4">
                    Cảm ơn bạn đã tin tưởng mua sắm tại cửa hàng của chúng tôi. Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
                </p>

                <!-- Order Details Panel -->
                <div class="bg-light rounded-4 p-3 mb-4 text-start">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted fs-7">Mã đơn hàng:</span>
                        <span class="fw-bold text-dark fs-7">#@Model</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted fs-7">Trạng thái:</span>
                        <span class="badge bg-success bg-opacity-75 fs-8 py-1.5 px-2 rounded-pill">Đang chuẩn bị hàng</span>
                    </div>
                </div>

                <!-- Navigation links -->
                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill py-3 fw-semibold shadow-sm transition-all hover-elevate">
                        <i class="bi bi-house-door-fill me-2"></i>Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fs-7 {
        font-size: 0.9rem;
    }
    .fs-8 {
        font-size: 0.8rem;
    }
    .hover-elevate:hover {
        transform: translateY(-2px);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>
