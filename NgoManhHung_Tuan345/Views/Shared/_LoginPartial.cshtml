@using Microsoft.AspNetCore.Identity
@using NgoManhHung_Tuan345.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user?.FullName ?? UserManager.GetUserName(User);
    
    <li class="nav-item me-3">
        <a asp-area="" asp-controller="Account" asp-action="Profile" class="text-dark text-decoration-none nav-link fw-semibold px-2 rounded hover-bg-light">
            <i class="bi bi-person-circle text-primary"></i> Xin chào, <strong class="text-primary">@fullName</strong>!
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-primary btn-sm" id="register" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm" id="login" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
    </li>
}
</ul>
