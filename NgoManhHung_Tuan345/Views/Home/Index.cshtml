@model IEnumerable<NgoManhHung_Tuan345.Models.Product>
@{
    ViewData["Title"] = "Cửa hàng của chúng tôi";
}

<!-- Hero banner section -->
<div class="p-5 mb-5 rounded-4 shadow-sm bg-gradient text-white position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
    <div class="position-relative z-index-1">
        <h1 class="display-4 fw-bold mb-2">Chào mừng đến với NgoManhHung Shop!</h1>
        <p class="lead mb-4">Khám phá bộ sưu tập sản phẩm cao cấp, chính hãng với giá tốt nhất thị trường.</p>
        <a href="#store-products" class="btn btn-light rounded-pill px-4 py-2 fw-semibold text-primary shadow-sm transition-all hover-elevate">Mua sắm ngay</a>
    </div>
    <!-- Decorative background elements -->
    <div class="position-absolute" style="width: 250px; height: 250px; background: rgba(255,255,255,0.1); border-radius: 50%; top: -50px; right: -50px;"></div>
    <div class="position-absolute" style="width: 150px; height: 150px; background: rgba(255,255,255,0.05); border-radius: 50%; bottom: -20px; right: 100px;"></div>
</div>

<div class="container py-2" id="store-products">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="h3 fw-bold text-dark mb-0">
            <i class="bi bi-grid-fill text-primary me-2"></i>Danh Sách Sản Phẩm
        </h2>
        <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill fs-7">
            Tìm thấy @Model.Count() sản phẩm
        </span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative product-card transition-all" 
                     style="background: #ffffff;">
                    <!-- Category Badge -->
                    @if (item.Category != null)
                    {
                        <span class="position-absolute top-0 start-0 m-3 badge bg-primary bg-opacity-75 backdrop-blur rounded-pill py-2 px-3 shadow-sm z-index-2">
                            @item.Category.Name
                        </span>
                    }

                    <!-- Product Image -->
                    <div class="position-relative overflow-hidden bg-light" style="padding-top: 100%;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover transition-transform" 
                                 alt="@item.Name" style="transition: transform 0.5s ease;" />
                        }
                        else
                        {
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-secondary bg-opacity-10 text-muted">
                                <i class="bi bi-image fs-1 mb-2"></i>
                                <span class="fs-8">Không có hình ảnh</span>
                            </div>
                        }
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold text-dark mb-2 text-truncate-2" style="height: 48px; line-height: 24px;">
                            @item.Name
                        </h5>
                        <p class="card-text text-secondary fs-7 text-truncate-2 mb-3" style="height: 40px;">
                            @item.Description
                        </p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted fs-8">Giá bán</span>
                                <span class="h5 fw-extrabold text-primary mb-0">
                                    @item.Price.ToString("#,##0") <small class="fs-8 fw-semibold">Vnđ</small>
                                </span>
                            </div>
                            <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@item.Id" 
                               class="btn btn-outline-primary w-100 rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center transition-all hover-elevate shadow-sm">
                                <i class="bi bi-cart-plus-fill me-2 fs-6"></i>Thêm vào giỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.12) !important;
    }
    .product-card:hover img {
        transform: scale(1.08);
    }
    .backdrop-blur {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .fs-7 {
        font-size: 0.9rem;
    }
    .fs-8 {
        font-size: 0.8rem;
    }
    .hover-elevate:hover {
        transform: translateY(-2px);
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .z-index-1 { z-index: 1; }
    .z-index-2 { z-index: 2; }
</style>
