@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 rounded-3 p-5">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 6rem;"></i>
                    </div>
                    <h1 class="display-6 fw-bold text-dark mb-3">Hạn Chế Quyền Truy Cập</h1>
                    <p class="text-muted mb-4">
                        Tài khoản của bạn không có đủ quyền hạn để truy cập vào khu vực này. 
                        Vui lòng quay lại Trang chủ hoặc đăng nhập bằng tài khoản Quản trị viên (Admin) để tiếp tục.
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                        <a href="/" class="btn btn-primary px-4 py-2 shadow-sm fw-semibold">
                            <i class="bi bi-house-door-fill me-2"></i> Quay về Trang chủ
                        </a>
                        <a href="/Identity/Account/Login" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập tài khoản khác
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
