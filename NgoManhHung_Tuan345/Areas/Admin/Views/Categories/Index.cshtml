@model IEnumerable<NgoManhHung_Tuan345.Models.Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-tags"></i> Danh sách danh mục</h2>
        <a asp-action="Add" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm danh mục mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Chưa có danh mục nào. Hãy nhấn vào nút "Thêm danh mục mới" để tạo.
        </div>
    }
    else
    {
        <div class="card shadow-sm col-md-8 mx-auto">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" style="width: 100px;">Mã số</th>
                            <th scope="col">Tên danh mục</th>
                            <th scope="col" class="text-center" style="width: 250px;">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil"></i> Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
