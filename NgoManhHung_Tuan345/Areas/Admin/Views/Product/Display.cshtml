@model NgoManhHung_Tuan345.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm - " + Model.Name;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết sản phẩm</h4>
                    <span class="badge bg-light text-dark fs-6">@Model.Category?.Name</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-5 text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 300px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="bg-light text-secondary d-flex justify-content-center align-items-center rounded border shadow-sm mx-auto" style="width: 200px; height: 200px;">
                                    <i class="bi bi-image" style="font-size: 64px;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-7">
                            <h3 class="text-primary fw-bold mb-2">@Model.Name</h3>
                            <h4 class="text-danger fw-bold mb-3">@Model.Price.ToString("#,##0") đ</h4>
                            
                            <h5 class="fw-bold text-secondary">Mô tả sản phẩm:</h5>
                            <p class="text-dark" style="white-space: pre-line;">@Model.Description</p>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Danh sách sản phẩm</a>
                        <div>
                            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
