@model NgoManhHung_Tuan345.Areas.Admin.Controllers.EditRoleViewModel
@{
    ViewData["Title"] = "Thay đổi quyền";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white p-4 rounded-top-4 text-center">
            <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill"></i> Thay đổi vai trò người dùng</h3>
            <p class="mb-0 text-white-50">Cấp hoặc thay đổi quyền truy cập hệ thống</p>
        </div>
        <div class="card-body p-4">
            <div class="mb-4 text-center">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-secondary rounded-circle fs-2 border mb-2" style="width: 60px; height: 60px;">
                    <i class="bi bi-person"></i>
                </div>
                <h5 class="fw-bold text-dark mb-0">@Model.FullName</h5>
                <p class="text-muted small">@Model.Email</p>
                <div class="badge bg-secondary px-3 py-1 fs-6">
                    Vai trò hiện tại: @(string.IsNullOrEmpty(Model.CurrentRole) ? "Không có" : Model.CurrentRole)
                </div>
            </div>

            <form asp-action="EditRole" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="FullName" />

                <div class="mb-4">
                    <label asp-for="NewRole" class="form-label fw-semibold text-dark">Chọn vai trò mới</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-shield-fill"></i></span>
                        <select asp-for="NewRole" asp-items="Model.RoleList" class="form-select" required>
                            <option value="">-- Chọn vai trò mới --</option>
                        </select>
                    </div>
                    <span asp-validation-for="NewRole" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                        <i class="bi bi-check-circle-fill"></i> Xác nhận thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 py-2 rounded-3 fw-semibold">
                        <i class="bi bi-x-circle-fill"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
